NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Opcional — solo si quieres activar la integracion con Strava (Ajustes -> Conectar con Strava).
# Crea una app en https://www.strava.com/settings/api y agrega como "Authorization Callback Domain"
# el dominio donde corra la app (ej. localhost o tu-dominio.vercel.app, sin https:// ni ruta).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Opcional — solo si quieres cobrar el Acceso Vitalicio (pagina /precio).
# 1. Crea una cuenta en https://dashboard.stripe.com y copia tu Secret key.
# 2. Crea un webhook (Developers -> Webhooks) apuntando a TU_DOMINIO/api/stripe/webhook,
#    escuchando el evento "checkout.session.completed", y copia su Signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Requerido junto con Stripe: Settings -> API -> "service_role" (secreta) de tu proyecto Supabase.
# El webhook la usa para activar el plan del usuario saltandose RLS. NUNCA exponer esta key al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — solo si quieres activar el Asistente de IA (boton flotante, registra gastos/
# entrenos/tareas/metas/habitos escribiendo en lenguaje natural, ej. "gaste 85 en el
# restaurante"). Crea una key en https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
